# Salin file ini jadi ".env" (untuk lokal) lalu isi dengan nilai dari
# Supabase Dashboard > Project Settings > API.
# Di Vercel/Netlify, isi nilai yang sama lewat menu Environment Variables
# mereka (jangan upload file .env ke GitHub).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ey...isi-dengan-anon-public-key...
